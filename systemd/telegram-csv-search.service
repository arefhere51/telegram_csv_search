[Unit]
Description=Authorized Telegram CSV Search Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace these paths and the user with the VPS deployment location and account.
User=csvsearch
Group=csvsearch
WorkingDirectory=/opt/telegram_csv_search
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/telegram_csv_search/venv/bin/python /opt/telegram_csv_search/bot.py
Restart=on-failure
RestartSec=5
# Protect the service while keeping the project database and logs writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/telegram_csv_search/database /opt/telegram_csv_search/logs

[Install]
WantedBy=multi-user.target
